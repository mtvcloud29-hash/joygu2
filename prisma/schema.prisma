generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  READY_TO_SHIP
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
  REFUND
  STATUS_CHANGE
  SEARCH
}

model User {
  id                   String                @id @default(cuid())
  name                 String
  email                String                @unique
  passwordHash         String?
  phone                String?
  role                 Role                  @default(CUSTOMER)
  referralCode         String                @unique @default(cuid())
  rewardPoints         Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  emailVerifiedAt      DateTime?
  isActive             Boolean               @default(true)
  permissions          Json?
  addresses            Address[]
  orders               Order[]
  wishlist             WishlistItem[]
  reviews              Review[]
  sessions             Session[]
  resetTokens          PasswordResetToken[]
  activityLogs         ActivityLog[]
  customerNotes        CustomerNote[]
  lastLoginAt          DateTime?
  tags                 String[]
  blacklisted          Boolean               @default(false)
  lockedUntil          DateTime?
  loginAttempts        LoginAttempt[]
  blogPosts            BlogPost[]
  staffRoleAssignments StaffRoleAssignment[]
  authorSlug           String?               @unique
  authorBio            String?
  authorAvatarUrl      String?
  authorWebsite        String?
  authorSocialLinks    Json?
  featuredAuthor       Boolean               @default(false)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(false)
  reason    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  image       String
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                 String              @id @default(cuid())
  categoryId         String
  slug               String              @unique
  name               String
  description        String
  price              Decimal             @db.Decimal(12, 2)
  compareAt          Decimal?            @db.Decimal(12, 2)
  wholesalePrice     Decimal?            @db.Decimal(12, 2)
  stock              Int                 @default(0)
  lowStockAt         Int                 @default(5)
  material           String
  dimensions         String
  weight             String
  usage              String
  benefits           String[]
  featured           Boolean             @default(false)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  variants           ProductVariant[]
  orderItems         OrderItem[]
  reviews            Review[]
  wishlistedBy       WishlistItem[]
  inventoryHistories InventoryHistory[]
  warehouseStocks    WarehouseStock[]
  purchaseItems      PurchaseItem[]
  batches            Batch[]
  transferItems      StockTransferItem[]

  @@index([categoryId])
  @@index([featured, active])
  @@index([active, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id                 String              @id @default(cuid())
  productId          String
  name               String
  sku                String              @unique
  priceDelta         Decimal             @default(0) @db.Decimal(12, 2)
  stock              Int                 @default(0)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryHistories InventoryHistory[]
  warehouseStocks    WarehouseStock[]
  purchaseItems      PurchaseItem[]
  batches            Batch[]
  transferItems      StockTransferItem[]

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  userId            String?
  email             String
  customerName      String
  phone             String
  address           Json
  billingAddress    Json?
  subtotal          Decimal         @db.Decimal(12, 2)
  discount          Decimal         @default(0) @db.Decimal(12, 2)
  shipping          Decimal         @default(0) @db.Decimal(12, 2)
  total             Decimal         @db.Decimal(12, 2)
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentMethod     PaymentMethod
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  couponCode        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  timeline          OrderTimeline[]
  notes             OrderNote[]
  shipment          Shipment?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  slug      String
  price     Decimal @db.Decimal(12, 2)
  quantity  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType
  value       Decimal      @db.Decimal(12, 2)
  minSubtotal Decimal?     @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int          @default(0)
  startsAt    DateTime     @default(now())
  expiresAt   DateTime?
  active      Boolean      @default(true)
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId, status])
}

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  email      String   @unique
  subscribed Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id            String         @id @default(cuid())
  userId        String?
  action        ActivityAction
  entity        String
  entityId      String?
  metadata      Json?
  previousValue Json?
  newValue      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum CmsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model MediaAsset {
  id          String    @id @default(cuid())
  key         String    @unique
  url         String
  name        String
  folder      String    @default("root")
  mimeType    String
  kind        MediaKind
  size        Int       @default(0)
  width       Int?
  height      Int?
  alt         String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([folder, createdAt])
  @@index([kind, createdAt])
}

model CmsPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  status      CmsStatus @default(DRAFT)
  blocks      Json
  seo         Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, updatedAt])
}

enum InventoryReason {
  MANUAL_ADJUSTMENT
  ORDER_PLACED
  ORDER_CANCELLED
  REFUND
  PURCHASE_ENTRY
  STOCK_TRANSFER
  DAMAGE
  RETURN
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  company   String
  gst       String?
  phone     String
  email     String
  address   String
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  purchases Purchase[]
  batches   Batch[]

  @@index([company])
}

model Warehouse {
  id                   String             @id @default(cuid())
  name                 String
  address              String
  manager              String
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  stocks               WarehouseStock[]
  batches              Batch[]
  sourceTransfers      StockTransfer[]    @relation("sourceWarehouse")
  destinationTransfers StockTransfer[]    @relation("destinationWarehouse")
  purchaseItems        PurchaseItem[]
  inventoryHistories   InventoryHistory[]
}

model WarehouseStock {
  id          String          @id @default(cuid())
  warehouseId String
  productId   String
  variantId   String?
  onHand      Int             @default(0)
  reserved    Int             @default(0)
  incoming    Int             @default(0)
  updatedAt   DateTime        @updatedAt
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, variantId])
  @@index([productId, warehouseId])
}

model Purchase {
  id            String         @id @default(cuid())
  supplierId    String
  invoiceNumber String
  purchaseDate  DateTime       @default(now())
  status        PurchaseStatus @default(RECEIVED)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([purchaseDate])
}

model PurchaseItem {
  id            String          @id @default(cuid())
  purchaseId    String
  productId     String
  variantId     String?
  warehouseId   String
  batchId       String?
  quantity      Int
  purchasePrice Decimal         @db.Decimal(12, 2)
  gst           Decimal         @default(0) @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  purchase      Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  batch         Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([purchaseId])
}

model Batch {
  id                String             @id @default(cuid())
  batchNumber       String             @unique
  supplierId        String?
  warehouseId       String
  productId         String
  variantId         String?
  purchaseDate      DateTime           @default(now())
  quantity          Int
  remainingQuantity Int
  purchasePrice     Decimal            @db.Decimal(12, 2)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant           ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseItems     PurchaseItem[]
  inventoryHistory  InventoryHistory[]

  @@index([productId, warehouseId, purchaseDate])
}

model InventoryHistory {
  id              String          @id @default(cuid())
  productId       String
  variantId       String?
  warehouseId     String?
  batchId         String?
  previousStock   Int
  newStock        Int
  quantityChanged Int
  reason          InventoryReason
  notes           String?
  userId          String?
  createdAt       DateTime        @default(now())
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse       Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
}

model StockTransfer {
  id                     String              @id @default(cuid())
  sourceWarehouseId      String
  destinationWarehouseId String
  status                 TransferStatus      @default(DRAFT)
  notes                  String?
  createdById            String?
  createdAt              DateTime            @default(now())
  completedAt            DateTime?
  sourceWarehouse        Warehouse           @relation("sourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse           @relation("destinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  items                  StockTransferItem[]

  @@index([status, createdAt])
}

model StockTransferItem {
  id         String          @id @default(cuid())
  transferId String
  productId  String
  variantId  String?
  quantity   Int
  transfer   StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([transferId])
}

model OrderTimeline {
  id             String       @id @default(cuid())
  orderId        String
  userId         String?
  oldStatus      OrderStatus?
  newStatus      OrderStatus
  reason         String?
  ipAddress      String?
  userAgent      String?
  notifyCustomer Boolean      @default(false)
  createdAt      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  userId    String?
  body      String
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Shipment {
  id             String   @id @default(cuid())
  orderId        String   @unique
  provider       String
  trackingNumber String?
  awb            String?
  courier        String?
  weight         Decimal? @db.Decimal(10, 2)
  dimensions     Json?
  pickupAddress  Json?
  status         String   @default("PENDING")
  manifestUrl    String?
  labelUrl       String?
  invoiceUrl     String?
  trackingUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminNotification {
  id         String    @id @default(cuid())
  title      String
  message    String
  type       String
  priority   String    @default("NORMAL")
  readAt     DateTime?
  archivedAt DateTime?
  entity     String?
  entityId   String?
  createdAt  DateTime  @default(now())

  @@index([readAt, createdAt])
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
}

enum BlogCommentStatus {
  PENDING
  APPROVED
  REJECTED
  SPAM
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model BlogPost {
  id              String        @id @default(cuid())
  authorId        String
  categoryId      String?
  title           String
  slug            String        @unique
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  coverImage      String?
  featuredImage   String?
  tags            String[]
  relatedPostIds  String[]
  readingTime     Int           @default(1)
  status          BlogStatus    @default(DRAFT)
  featured        Boolean       @default(false)
  viewCount       Int           @default(0)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  author          User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments        BlogComment[]

  @@index([status, publishedAt])
  @@index([categoryId, createdAt])
}

model BlogComment {
  id        String            @id @default(cuid())
  postId    String
  name      String
  email     String
  body      String
  status    BlogCommentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  post      BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, status, createdAt])
}

model StaffRole {
  id          String                @id @default(cuid())
  name        String                @unique
  slug        String                @unique
  description String?
  permissions Json
  createdById String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  assignments StaffRoleAssignment[]
}

model StaffRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      StaffRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
